{
  "manifest_version": 3,
  "name": "EntityScholar",
  "version": "1.0.0",
  "description": "Extract key entities from web pages and search academic sources (.edu domains) for scholarly context",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://language.googleapis.com/*",
    "https://*.edu/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Scan current page for entities"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "settings/settings.html"
}
